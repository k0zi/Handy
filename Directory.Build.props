<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NeutralLanguage>en</NeutralLanguage>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
    <RiceVersion>26.10.6</RiceVersion>
    <MvvmToolkitVersion>8.4.2</MvvmToolkitVersion>
  </PropertyGroup>
  <!-- Version numbers come from version.json (major = year, minor = month) plus the git height as patch, e.g. 26.10.3. -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all" />
  </ItemGroup>
</Project>
