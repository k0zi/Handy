<rice:RiceWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:rice="clr-namespace:KD.Avalonia.Rice.Controls;assembly=KD.Avalonia.Rice"
                 xmlns:h="clr-namespace:Handy"
                 xmlns:vm="clr-namespace:Handy.ViewModels"
                 x:Class="Handy.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Width="1000" Height="640" MinWidth="640" MinHeight="400"
                 WindowStartupLocation="CenterScreen"
                 ShowSettingsButton="True" ShowAboutButton="True"
                 SettingsRequested="OnSettingsRequested">
  <DockPanel>
    <rice:RiceSideMenu Name="SideMenu" DockPanel.Dock="Left"
                       ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}">
      <rice:RiceSideMenu.Header>
        <TextBlock FontWeight="SemiBold" Text="Handy" TextTrimming="CharacterEllipsis" />
      </rice:RiceSideMenu.Header>
      <rice:RiceSideMenu.Styles>
        <Style Selector="rice|RiceSideMenuItem" x:DataType="vm:ModuleMenuItemViewModel">
          <Setter Property="Icon" Value="{Binding Icon}" />
          <Setter Property="Content" Value="{Binding Title}" />
        </Style>
      </rice:RiceSideMenu.Styles>
    </rice:RiceSideMenu>

    <Panel>
      <ContentControl Name="ModuleView" Content="{Binding SelectedModule.View}" />
      <StackPanel Name="EmptyState" IsVisible="{Binding !Modules.Count}" Spacing="8"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                   Text="{Binding [NoModules], Source={x:Static h:L.Instance}}" />
        <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource RiceForegroundMutedBrush}"
                   Text="{Binding [NoModulesHint], Source={x:Static h:L.Instance}}" />
        <SelectableTextBlock HorizontalAlignment="Center" Foreground="{DynamicResource RiceForegroundMutedBrush}"
                             Text="{Binding ModulesDirectory}" />
      </StackPanel>
    </Panel>
  </DockPanel>
</rice:RiceWindow>
