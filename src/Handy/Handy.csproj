<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(MvvmToolkitVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Handy.Abstractions\Handy.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The own license and the third-party notices travel with the binaries (see THIRD_PARTY_NOTICES.md). -->
    <None Include="..\..\LICENSE;..\..\THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\licenses\**" LinkBase="licenses" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Handy.Tests" />
  </ItemGroup>
</Project>
